<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview: day scheme, 4 filled + half (12:45). Colours
     come from drawables generated by scripts/sync_palette.py. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:src="@drawable/glass_pill" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/fill_day" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/fill_day" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/fill_day" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/fill_day" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/glass_pill" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/glass_pill" android:scaleType="fitXY" />
    <ImageView android:layout_width="0dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_weight="1" android:src="@drawable/glass_pill" android:scaleType="fitXY" />

</LinearLayout>
